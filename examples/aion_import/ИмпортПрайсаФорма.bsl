// AION Import v0.5 - безопасное чтение Excel в тонком клиенте 1С.
// В базу 1С никакие данные не записываются.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КомандаЧтения = Команды.Добавить("AIONВыбратьФайл");
	КомандаЧтения.Заголовок = "Выбрать Excel";
	КомандаЧтения.Действие = "AIONВыбратьФайл";
	КнопкаЧтения = Элементы.Добавить("AIONКнопкаЧтения", Тип("КнопкаФормы"));
	КнопкаЧтения.ИмяКоманды = "AIONВыбратьФайл";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура AIONВыбратьФайл(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	Оповещение = Новый ОписаниеОповещения("AIONФайлПомещен", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , Диалог, Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура AIONФайлПомещен(Результат, Адрес, ИмяФайла, ДополнительныеПараметры) Экспорт
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ДанныеФайла = AIONПрочитатьНаСервере(Адрес, ИмяФайла);
	Исключение
		Предупреждение("Не удалось прочитать Excel на сервере: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Сообщить("AION: Excel прочитан. Строк: " + Строка(ДанныеФайла.Высота) + ", колонок: " + Строка(ДанныеФайла.Ширина));
	Для Каждого ТекстСтроки Из ДанныеФайла.ПервыеСтроки Цикл
		Сообщить(ТекстСтроки);
	КонецЦикла;
	Для Каждого ТекстТовара Из ДанныеФайла.Товары Цикл
		Сообщить(ТекстТовара);
	КонецЦикла;
	Сообщить("AION: строк с артикулом: " + Строка(ДанныеФайла.КоличествоТоваров) + "; дублей артикулов: " + Строка(ДанныеФайла.Дубли));
	Предупреждение("AION: чтение завершено, данные в 1С не изменялись. Первые строки - в сообщениях.");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция AIONПрочитатьНаСервере(Адрес, ИмяФайла)
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Не удалось получить файл из временного хранилища.";
	КонецЕсли;
	// Временный файл нужен для метода ТабличныйДокумент.Прочитать().
	Расширение = "xlsx";
	Если НРег(Прав(ИмяФайла, 4)) = ".xls" Тогда
		Расширение = "xls";
	КонецЕсли;
	ВременныйФайл = ПолучитьИмяВременногоФайла(Расширение);
	Попытка
		Данные.Записать(ВременныйФайл);
		УдалитьИзВременногоХранилища(Адрес);
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ВременныйФайл);
		Результат = Новый Структура("Высота,Ширина,ПервыеСтроки,Товары,КоличествоТоваров,Дубли",
			ТабДок.ВысотаТаблицы, ТабДок.ШиринаТаблицы, Новый Массив, Новый Массив, 0, 0);
		Для НомерСтроки = 1 По Мин(ТабДок.ВысотаТаблицы, 15) Цикл
			ТекстСтроки = "";
			Для НомерКолонки = 1 По Мин(ТабДок.ШиринаТаблицы, 15) Цикл
				ЗначениеЯчейки = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
				Если Не ПустаяСтрока(ЗначениеЯчейки) Тогда
					ТекстСтроки = ТекстСтроки + " [" + Строка(НомерКолонки) + "] " + Лев(ЗначениеЯчейки, 80);
				КонецЕсли;
			КонецЦикла;
			Если Не ПустаяСтрока(ТекстСтроки) Тогда
				Результат.ПервыеСтроки.Добавить("Строка " + Строка(НомерСтроки) + ":" + Лев(ТекстСтроки, 800));
			КонецЕсли;
		КонецЦикла;
		// Находим шапку по содержимому, а не по фиксированному номеру строки.
		НомерШапки = 0;
		КолонкаАртикула = 0;
		КолонкаРРЦ = 0;
		КолонкаОпт = 0;
		КолонкаСклад = 0;
		КолонкиНазвания = Новый Массив;
		Для НомерСтроки = 1 По Мин(ТабДок.ВысотаТаблицы, 30) Цикл
			КандидатАртикула = 0;
			КандидатНазвания = Новый Массив;
			КандидатРРЦ = 0;
			КандидатОпт = 0;
			КандидатСклад = 0;
			Для НомерКолонки = 1 По Мин(ТабДок.ШиринаТаблицы, 40) Цикл
				Заголовок = ВРег(СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст));
				Если Заголовок = "АРТИКУЛ" Или Заголовок = "SKU" Тогда
					КандидатАртикула = НомерКолонки;
				ИначеЕсли Заголовок = "НОМЕНКЛАТУРА" Или Заголовок = "НАИМЕНОВАНИЕ" Тогда
					КандидатНазвания.Добавить(НомерКолонки);
				ИначеЕсли Заголовок = "РРЦ" Тогда
					КандидатРРЦ = НомерКолонки;
				ИначеЕсли Заголовок = "ОПТ" Тогда
					КандидатОпт = НомерКолонки;
				ИначеЕсли Заголовок = "ОСНОВНОЙ СКЛАД" Тогда
					КандидатСклад = НомерКолонки;
				КонецЕсли;
			КонецЦикла;
			Если КандидатАртикула > 0 И КандидатНазвания.Количество() > 0 Тогда
				НомерШапки = НомерСтроки;
				КолонкаАртикула = КандидатАртикула;
				КолонкиНазвания = КандидатНазвания;
				КолонкаРРЦ = КандидатРРЦ;
				КолонкаОпт = КандидатОпт;
				КолонкаСклад = КандидатСклад;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НомерШапки = 0 Тогда
			Результат.Товары.Добавить("AION: шапка с артикулом и названием не найдена.");
		Иначе
			Результат.Товары.Добавить("AION: шапка строка " + Строка(НомерШапки)
				+ "; артикул " + Строка(КолонкаАртикула)
				+ "; название в " + Строка(КолонкиНазвания.Количество()) + " столбцах"
				+ "; РРЦ " + Строка(КолонкаРРЦ)
				+ "; опт " + Строка(КолонкаОпт)
				+ "; склад поставщика " + Строка(КолонкаСклад));
			ВстреченныеАртикулы = Новый Соответствие;
			Для НомерСтроки = НомерШапки + 1 По Мин(ТабДок.ВысотаТаблицы, 25000) Цикл
				Артикул = СокрЛП(ТабДок.Область(НомерСтроки, КолонкаАртикула).Текст);
				Если ПустаяСтрока(Артикул) Тогда
					Продолжить;
				КонецЕсли;
				Результат.КоличествоТоваров = Результат.КоличествоТоваров + 1;
				Если ВстреченныеАртикулы.Получить(ВРег(Артикул)) = Неопределено Тогда
					ВстреченныеАртикулы.Вставить(ВРег(Артикул), Истина);
				Иначе
					Результат.Дубли = Результат.Дубли + 1;
				КонецЕсли;
				Если Результат.КоличествоТоваров <= 8 Тогда
					ТекстНазваний = "";
					Для Каждого КолонкаНазвания Из КолонкиНазвания Цикл
						ТекстНазваний = ТекстНазваний + " {" + Строка(КолонкаНазвания) + ":"
							+ Лев(СокрЛП(ТабДок.Область(НомерСтроки, КолонкаНазвания).Текст), 70) + "}";
					КонецЦикла;
					ТекстЦен = "";
					Если КолонкаРРЦ > 0 Тогда
						ТекстЦен = ТекстЦен + " РРЦ=" + СокрЛП(ТабДок.Область(НомерСтроки, КолонкаРРЦ).Текст);
					КонецЕсли;
					Если КолонкаОпт > 0 Тогда
						ТекстЦен = ТекстЦен + " Опт=" + СокрЛП(ТабДок.Область(НомерСтроки, КолонкаОпт).Текст);
					КонецЕсли;
					Если КолонкаСклад > 0 Тогда
						ТекстЦен = ТекстЦен + " Склад поставщика=" + СокрЛП(ТабДок.Область(НомерСтроки, КолонкаСклад).Текст);
					КонецЕсли;
					Результат.Товары.Добавить("Товар " + Строка(НомерСтроки)
						+ " Артикул=" + Артикул + ТекстНазваний + ТекстЦен);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		Попытка
			УдалитьФайлы(ВременныйФайл);
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ВременныйФайл);
	Возврат Результат;
КонецФункции

#КонецОбласти
