// AION Import v0.3 - чтение прайса в пользовательском режиме.
// ТОЛЬКО ЧТЕНИЕ. Запись в 1С запрещена.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КомандаЧтения = Команды.Добавить("AIONВыбратьФайл");
	КомандаЧтения.Заголовок = "Выбрать Excel";
	КомандаЧтения.Действие = "AIONВыбратьФайл";
	КнопкаЧтения = Элементы.Добавить("AIONКнопкаЧтения", Тип("КнопкаФормы"));
	КнопкаЧтения.ИмяКоманды = "AIONВыбратьФайл";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура AIONВыбратьФайл(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	ТабДок = Новый ТабличныйДокумент;
	Попытка
		ТабДок.Прочитать(Диалог.ПолноеИмяФайла);
	Исключение
		Предупреждение("Excel не прочитан: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Высота = ТабДок.ВысотаТаблицы;
	Ширина = ТабДок.ШиринаТаблицы;
	Сообщить("AION: Excel открыт. Строк: " + Строка(Высота) + ", колонок: " + Строка(Ширина));
	ПределСтрок = Мин(Высота, 15);
	ПределКолонок = Мин(Ширина, 15);
	Для НомерСтроки = 1 По ПределСтрок Цикл
		ТекстСтроки = "";
		Для НомерКолонки = 1 По ПределКолонок Цикл
			ЗначениеЯчейки = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
			Если Не ПустаяСтрока(ЗначениеЯчейки) Тогда
				ТекстСтроки = ТекстСтроки + " [" + Строка(НомерКолонки) + "] " + Лев(ЗначениеЯчейки, 80);
			КонецЕсли;
		КонецЦикла;
		Если Не ПустаяСтрока(ТекстСтроки) Тогда
			Сообщить("Строка " + Строка(НомерСтроки) + ":" + Лев(ТекстСтроки, 800));
		КонецЕсли;
	КонецЦикла;
	Предупреждение("AION: прайс прочитан, ничего в базу не записано. Результаты - в сообщениях 1С.");
КонецПроцедуры

#КонецОбласти
