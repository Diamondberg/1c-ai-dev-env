// AION Import v0.4 - безопасное чтение Excel в тонком клиенте 1С.
// В базу 1С никакие данные не записываются.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	КомандаЧтения = Команды.Добавить("AIONВыбратьФайл");
	КомандаЧтения.Заголовок = "Выбрать Excel";
	КомандаЧтения.Действие = "AIONВыбратьФайл";
	КнопкаЧтения = Элементы.Добавить("AIONКнопкаЧтения", Тип("КнопкаФормы"));
	КнопкаЧтения.ИмяКоманды = "AIONВыбратьФайл";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура AIONВыбратьФайл(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	Оповещение = Новый ОписаниеОповещения("AIONФайлПомещен", ЭтотОбъект);
	НачатьПомещениеФайла(Оповещение, , Диалог, Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура AIONФайлПомещен(Результат, Адрес, ИмяФайла, ДополнительныеПараметры) Экспорт
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ДанныеФайла = AIONПрочитатьНаСервере(Адрес, ИмяФайла);
	Исключение
		Предупреждение("Не удалось прочитать Excel на сервере: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	Сообщить("AION: Excel прочитан. Строк: " + Строка(ДанныеФайла.Высота) + ", колонок: " + Строка(ДанныеФайла.Ширина));
	Для Каждого ТекстСтроки Из ДанныеФайла.ПервыеСтроки Цикл
		Сообщить(ТекстСтроки);
	КонецЦикла;
	Предупреждение("AION: чтение завершено, данные в 1С не изменялись. Первые строки - в сообщениях.");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция AIONПрочитатьНаСервере(Адрес, ИмяФайла)
	Данные = ПолучитьИзВременногоХранилища(Адрес);
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Не удалось получить файл из временного хранилища.";
	КонецЕсли;
	// Временный файл нужен для метода ТабличныйДокумент.Прочитать().
	Расширение = "xlsx";
	Если НРег(Прав(ИмяФайла, 4)) = ".xls" Тогда
		Расширение = "xls";
	КонецЕсли;
	ВременныйФайл = ПолучитьИмяВременногоФайла(Расширение);
	Попытка
		Данные.Записать(ВременныйФайл);
		УдалитьИзВременногоХранилища(Адрес);
		ТабДок = Новый ТабличныйДокумент;
		ТабДок.Прочитать(ВременныйФайл);
		Результат = Новый Структура("Высота,Ширина,ПервыеСтроки",
			ТабДок.ВысотаТаблицы, ТабДок.ШиринаТаблицы, Новый Массив);
		Для НомерСтроки = 1 По Мин(ТабДок.ВысотаТаблицы, 15) Цикл
			ТекстСтроки = "";
			Для НомерКолонки = 1 По Мин(ТабДок.ШиринаТаблицы, 15) Цикл
				ЗначениеЯчейки = СокрЛП(ТабДок.Область(НомерСтроки, НомерКолонки).Текст);
				Если Не ПустаяСтрока(ЗначениеЯчейки) Тогда
					ТекстСтроки = ТекстСтроки + " [" + Строка(НомерКолонки) + "] " + Лев(ЗначениеЯчейки, 80);
				КонецЕсли;
			КонецЦикла;
			Если Не ПустаяСтрока(ТекстСтроки) Тогда
				Результат.ПервыеСтроки.Добавить("Строка " + Строка(НомерСтроки) + ":" + Лев(ТекстСтроки, 800));
			КонецЕсли;
		КонецЦикла;
	Исключение
		Попытка
			УдалитьФайлы(ВременныйФайл);
		Исключение
		КонецПопытки;
		ВызватьИсключение;
	КонецПопытки;
	УдалитьФайлы(ВременныйФайл);
	Возврат Результат;
КонецФункции

#КонецОбласти
