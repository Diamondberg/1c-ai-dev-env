// AION Import: безопасный предпросмотр Excel, без изменения базы 1С.
// Внимание: работа с локальным файлом через клиент проверяется в УТ 11.5.
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ПустаяСтрока(ПоставщикИмя) Тогда
		ПоставщикИмя = "Norden.group";
	КонецЕсли;
	КомандаИмпорта = Команды.Добавить("ЗагрузитьExcel");
	КомандаИмпорта.Заголовок = "Открыть Excel";
	КомандаИмпорта.Действие = "ЗагрузитьExcel";
	КнопкаИмпорта = Элементы.Добавить("КнопкаExcel", Тип("КнопкаФормы"));
	КнопкаИмпорта.ИмяКоманды = "ЗагрузитьExcel";
	ПолеПоставщика = Элементы.Добавить("ИмяПоставщика", Тип("ПолеФормы"));
	ПолеПоставщика.ПутьКДанным = "ПоставщикИмя";
	ПолеПоставщика.Вид = ВидПоляФормы.ПолеВвода;
	ПолеПоставщика.Заголовок = "Поставщик";
	Таблица = Элементы.Добавить("ТаблицаПредпросмотра", Тип("ТаблицаФормы"));
	Таблица.ПутьКДанным = "Предпросмотр";
	Таблица.Заголовок = "Предпросмотр: в базе ничего не изменено";
	Для Каждого ИмяКолонки Из СтрРазделить("Артикул,Наименование,РРЦ,Опт,ОстатокПоставщика,Статус", ",") Цикл
		Элемент = Элементы.Добавить("Колонка" + ИмяКолонки, Тип("ПолеФормы"), Таблица);
		Элемент.ПутьКДанным = "Предпросмотр." + ИмяКолонки;
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьExcel(Команда)
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "Excel (*.xlsx;*.xls)|*.xlsx;*.xls";
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	Документ = Новый ТабличныйДокумент;
	Попытка
		Документ.Прочитать(Диалог.ПолноеИмяФайла);
	Исключение
		Предупреждение("Ошибка чтения Excel: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;
	СтрокиExcel = Новый Массив;
	Для НомерСтроки = 1 По Мин(Документ.ВысотаТаблицы, 20000) Цикл
		Значения = Новый Массив;
		Для НомерКолонки = 1 По Мин(Документ.ШиринаТаблицы, 40) Цикл
			Значения.Добавить(СокрЛП(Документ.Область(НомерСтроки, НомерКолонки).Текст));
		КонецЦикла;
		СтрокиExcel.Добавить(Значения);
	КонецЦикла;
	РаспознатьДанные(СтрокиExcel);
КонецПроцедуры

&НаСервере
Процедура РаспознатьДанные(СтрокиExcel)
	Предпросмотр.Очистить();
	Если СтрокиExcel.Количество() = 0 Тогда
		Сообщить("Нет строк");
		Возврат;
	КонецЕсли;
	НомерШапки = -1;
	Для Номер = 0 По Мин(СтрокиExcel.Количество() - 1, 29) Цикл
		Карта = НайтиПоля(СтрокиExcel[Номер]);
		Если Карта.Свойство("Артикул") И Карта.Свойство("Наименование") Тогда
			НомерШапки = Номер;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НомерШапки = -1 Тогда
		Сообщить("Не распознаны столбцы: артикул и наименование");
		Возврат;
	КонецЕсли;
	Встреченные = Новый Соответствие;
	Для Номер = НомерШапки + 1 По СтрокиExcel.Количество() - 1 Цикл
		Значения = СтрокиExcel[Номер];
		Артикул = ПрочитатьПоле(Значения, Карта, "Артикул");
		Наименование = ПрочитатьПоле(Значения, Карта, "Наименование");
		Если ПустаяСтрока(Артикул) Или ПустаяСтрока(Наименование) Тогда
			Продолжить;
		КонецЕсли;
		Строка = Предпросмотр.Добавить();
		Строка.Артикул = Артикул;
		Строка.Наименование = Наименование;
		Строка.РРЦ = ПрочитатьЧисло(ПрочитатьПоле(Значения, Карта, "РРЦ"));
		Строка.Опт = ПрочитатьЧисло(ПрочитатьПоле(Значения, Карта, "Опт"));
		Строка.ОстатокПоставщика = ПрочитатьЧисло(ПрочитатьПоле(Значения, Карта, "ОстатокПоставщика"));
		Ключ = ВРег(Артикул);
		Если Встреченные.Получить(Ключ) = Неопределено Тогда
			Встреченные.Вставить(Ключ, Истина);
			Строка.Статус = "Предпросмотр";
		Иначе
			Строка.Статус = "Дубль артикула в файле";
		КонецЕсли;
	КонецЦикла;
	Сообщить("Прочитано строк: " + Строка(Предпросмотр.Количество()) + ". Никаких записей в базу.");
КонецПроцедуры

&НаСервере
Функция НайтиПоля(Заголовки)
	Карта = Новый Структура;
	Для Номер = 0 По Заголовки.Количество() - 1 Цикл
		Имя = ВРег(СокрЛП(Заголовки[Номер]));
		Если Имя = "АРТИКУЛ" Или Имя = "SKU" Или Имя = "КОД ТОВАРА" Тогда
			Карта.Вставить("Артикул", Номер);
		ИначеЕсли Имя = "НАИМЕНОВАНИЕ" Или Имя = "НОМЕНКЛАТУРА" Или Имя = "НАЗВАНИЕ" Тогда
			Карта.Вставить("Наименование", Номер);
		ИначеЕсли Имя = "РРЦ" Или Имя = "РОЗНИЦА" Тогда
			Карта.Вставить("РРЦ", Номер);
		ИначеЕсли Имя = "ОПТ" Или Имя = "ЗАКУПОЧНАЯ ЦЕНА" Тогда
			Карта.Вставить("Опт", Номер);
		ИначеЕсли Имя = "ОСНОВНОЙ СКЛАД" Или Имя = "ОСТАТОК ПОСТАВЩИКА" Тогда
			Карта.Вставить("ОстатокПоставщика", Номер);
		КонецЕсли;
	КонецЦикла;
	Возврат Карта;
КонецФункции

&НаСервере
Функция ПрочитатьПоле(Значения, Карта, ИмяПоля)
	Номер = 0;
	Если Не Карта.Свойство(ИмяПоля, Номер) Тогда
		Возврат "";
	КонецЕсли;
	Если Номер >= Значения.Количество() Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Значения[Номер]);
КонецФункции

&НаСервере
Функция ПрочитатьЧисло(Текст)
	Текст = СтрЗаменить(СтрЗаменить(СокрЛП(Текст), " ", ""), ".", ",");
	Если ПустаяСтрока(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

#КонецОбласти
